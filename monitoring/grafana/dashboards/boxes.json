        {
          "expr": "histogram_quantile(0.5, clamp_min(sum by (le) (mpp_duration_seconds_bucket{op=\"copy_n_boxes\"}) - (sum by (le) (mpp_duration_seconds_bucket{op=\"copy_n_boxes\"} offset $__range) or sum by (le) (mpp_duration_seconds_bucket{op=\"copy_n_boxes\"}) * 0), 0))",
          "legendFormat": "copy_n_boxes",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "write_box"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
