      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 8,
            "spanNulls": true,
            "lineInterpolation": "stepAfter",
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "write_n_boxes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "read_n_boxes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "copy_n_boxes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "Over the selected range",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "bargauge",
      "title": "Median duration",
      "description": "Approximate: estimated from histogram buckets that grow by 1.5x.",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, clamp_min(sum by (le) (mpp_duration_seconds_bucket{op=\"write_box\"}) - (sum by (le) (mpp_duration_seconds_bucket{op=\"write_box\"} offset $__range) or sum by (le) (mpp_duration_seconds_bucket{op=\"write_box\"}) * 0), 0))",
          "legendFormat": "write_box",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, clamp_min(sum by (le) (mpp_duration_seconds_bucket{op=\"read_box\"}) - (sum by (le) (mpp_duration_seconds_bucket{op=\"read_box\"} offset $__range) or sum by (le) (mpp_duration_seconds_bucket{op=\"read_box\"}) * 0), 0))",
          "legendFormat": "read_box",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.5, clamp_min(sum by (le) (mpp_duration_seconds_bucket{op=\"write_n_boxes\"}) - (sum by (le) (mpp_duration_seconds_bucket{op=\"write_n_boxes\"} offset $__range) or sum by (le) (mpp_duration_seconds_bucket{op=\"write_n_boxes\"}) * 0), 0))",
          "legendFormat": "write_n_boxes",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.5, clamp_min(sum by (le) (mpp_duration_seconds_bucket{op=\"read_n_boxes\"}) - (sum by (le) (mpp_duration_seconds_bucket{op=\"read_n_boxes\"} offset $__range) or sum by (le) (mpp_duration_seconds_bucket{op=\"read_n_boxes\"}) * 0), 0))",
          "legendFormat": "read_n_boxes",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "refId": "D"
