      }
    },
    {
      "type": "table",
      "title": "Failures by result",
      "description": "",
      "targets": [
        {
          "expr": "clamp_min(sum by (op, result) (mpp_ops_total{result!=\"ok\"}) - (sum by (op, result) (mpp_ops_total{result!=\"ok\"} offset $__range) or sum by (op, result) (mpp_ops_total{result!=\"ok\"}) * 0), 0) > 0",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
