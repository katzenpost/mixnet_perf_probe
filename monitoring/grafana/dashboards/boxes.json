      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "Success rate",
      "description": "",
      "targets": [
        {
          "expr": "clamp_min(sum by (op) (mpp_ops_total{op=~\"write_box|read_box|write_n_boxes|read_n_boxes|copy_n_boxes\",result=\"ok\"}) - (sum by (op) (mpp_ops_total{op=~\"write_box|read_box|write_n_boxes|read_n_boxes|copy_n_boxes\",result=\"ok\"} offset $__range) or sum by (op) (mpp_ops_total{op=~\"write_box|read_box|write_n_boxes|read_n_boxes|copy_n_boxes\",result=\"ok\"}) * 0), 0) / clamp_min(sum by (op) (mpp_ops_total{op=~\"write_box|read_box|write_n_boxes|read_n_boxes|copy_n_boxes\"}) - (sum by (op) (mpp_ops_total{op=~\"write_box|read_box|write_n_boxes|read_n_boxes|copy_n_boxes\"} offset $__range) or sum by (op) (mpp_ops_total{op=~\"write_box|read_box|write_n_boxes|read_n_boxes|copy_n_boxes\"}) * 0), 0)",
          "legendFormat": "{{op}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#0ca30c"
          },
          "max": 1
