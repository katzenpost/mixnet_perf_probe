    {
      "type": "timeseries",
      "title": "Packets sent per second",
      "description": "Real messages and decoys leave at the same Poisson rates, so this should look the same whether or not the probe is active.",
      "targets": [
        {
          "expr": "rate(katzenpost_client_lambdap_fifo_pop_total[5m])",
          "legendFormat": "real (LambdaP)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "rate(katzenpost_client_lambdap_decoy_total[5m])",
          "legendFormat": "decoy (LambdaP)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "rate(katzenpost_client_lambdal_decoy_total[5m])",
          "legendFormat": "loop decoy (LambdaL)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 8,
            "spanNulls": true,
            "lineInterpolation": "linear",
            "axisSoftMin": 0,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "real (LambdaP)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "decoy (LambdaP)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "loop decoy (LambdaL)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
